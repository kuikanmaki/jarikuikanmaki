      "artifact": "artifacts/ch16-s08.md",
      "content_kind": "html_article",
      "language": "en",
      "summary": "2019 Viruses paper on QX-type IBV spike S2 determining neurotropism—example of coronavirus spike/domain engineering literature in the Chinese research ecosystem.",
      "book_role": "2014 paper “Proximal Origin” cited, misleadingly, as proof no prior backbone existed.",
      "topics": [],
      "entities": {
        "people": [
          "Jinlong Cheng"
        ],
