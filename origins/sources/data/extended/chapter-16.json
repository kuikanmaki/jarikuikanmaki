      "acquisition_note": "",
      "author_ids": [
        "person:jinlong-cheng"
      ],
      "publication_ids": [],
      "topic_ids": [],
      "note": {
        "title": "",
        "html": "<p>This 2014 paper was cited in “Proximal Origin” (<a href=\"?chapter=6\">Chapter 6</a> <em><a href=\"?source=ch06-s10\">Andersen et al. 2020</a></em>) as evidence that no known virus backbone existed for SARS-CoV-2. The citation is highly misleading: the paper predates the pandemic by five years, yet the authors asserted, based on this source: “However, the genetic data irrefutably show that SARS-CoV-2 is not derived from any previously used virus backbone.”</p>",
